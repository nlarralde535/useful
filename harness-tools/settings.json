{
  "statusLine": {
      "type": "command",
      "command": "bash /root/.claude/statusline-command.sh",
      "refreshInterval": 10
  },
  "env": {
    "EDITOR": "vim"
  },
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git grep *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git checkout *)"
    ]
  },
  "model": "opus"
}
